# ==============================================================================
# Studygram (Study Buddy) - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` and replace the placeholder values.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your `.env` or any file containing real API keys/secrets to Git.
# 2. NEVER prefix backend secrets with `EXPO_PUBLIC_` — variables prefixed with
#    `EXPO_PUBLIC_` are bundled into the client app bundle and readable by anyone!
# 3. Only client-facing public keys should use the `EXPO_PUBLIC_` prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication (Client-side, Required)
# ------------------------------------------------------------------------------
# Required for user authentication, session management, and profile info.
# Where to find:
#   1. Sign in to Clerk Dashboard: https://dashboard.clerk.com
#   2. Select your application -> API Keys
#   3. Copy the "Publishable key" (starts with pk_test_ or pk_live_)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ------------------------------------------------------------------------------
# 2. GetStream Chat & Video (Client-side, Required)
# ------------------------------------------------------------------------------
# Required by ChatWrapper and VideoProvider for real-time messaging, channels,
# and video/audio calling.
# Where to find:
#   1. Sign in to Stream Dashboard: https://dashboard.getstream.io
#   2. Select your app -> App Details -> "Key"
EXPO_PUBLIC_STREAM_API_KEY=your_stream_api_key_here

# ------------------------------------------------------------------------------
# 3. GetStream Backend Secret (Server-side, Required)
# ------------------------------------------------------------------------------
# Required by backend API routes (/api/token, /api/sync-user) for generating user
# tokens and synchronizing user profiles.
#
# WARNING: NEVER ADD `EXPO_PUBLIC_` TO THIS VARIABLE. KEEP THIS PRIVATE.
#
# Where to find:
#   1. Sign in to Stream Dashboard: https://dashboard.getstream.io
#   2. Select your app -> App Details -> "Secret"
STREAM_SECRET_KEY=your_stream_api_secret_here

# Optional: Stream API key alias for server-side routes
STREAM_API_KEY=your_stream_api_key_here

# ------------------------------------------------------------------------------
# 4. Sentry Error & Crash Reporting (Optional)
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_SENTRY_DSN:
#   Used by @sentry/react-native in src/app/_layout.tsx for error tracking and
#   session replay. If left blank, the app will use the default project DSN.
#   Where to find:
#     1. Sentry Dashboard: https://sentry.io
#     2. Settings -> Projects -> [Your Project] -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# SENTRY_AUTH_TOKEN:
#   Used during EAS builds / production builds by @sentry/react-native/expo
#   to upload release source maps. Not needed for local development.
#   Where to find:
#     1. Sentry Dashboard -> User Settings -> API -> Auth Tokens
#     2. Generate a token with 'project:releases' scope
SENTRY_AUTH_TOKEN=
